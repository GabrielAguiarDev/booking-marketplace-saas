# Segredos das Edge Functions.
#
# Copie para `supabase/functions/.env` e preencha. Esse arquivo é lido pelo
# `supabase start` no ambiente local e NÃO é versionado (.gitignore cobre
# `.env` e `.env.*`, com exceção deste `.env.example`).
#
# Em produção NÃO existe arquivo: use
#   supabase secrets set OPENAI_API_KEY=sk-...
#
# A chave nunca vai para o app. Ela é lida só dentro da Edge Function, que roda
# no servidor. Um bundle de app nativo se abre com um zip — chave em app é
# chave publicada.

# ── Assistente (assistant) ──────────────────────────────────────────────────
OPENAI_API_KEY=

# Modelo usado pelo assistente. Trocável sem mexer no código: se o crédito de
# teste apertar, aponte para um mais barato. Confira o nome exato na sua conta
# antes de trocar — nome errado devolve 404 da OpenAI.
OPENAI_MODEL=gpt-4o-mini

# OPCIONAL — deixe em branco. Vazio significa a OpenAI normal
# (https://api.openai.com/v1). Só preencha se você usar Azure OpenAI, um proxy
# corporativo, ou um servidor falso em teste.
OPENAI_BASE_URL=

# ── Convites (admin-invite, establishment-invite) ───────────────────────────
# Para onde o link do convite leva. Precisam estar em
# `auth.additional_redirect_urls` (config.toml local; painel do Auth em produção).
ADMIN_SITE_URL=http://localhost:3002/
# O portal recebe o convite da loja em `<PORTAL_SITE_URL>/convite`.
PORTAL_SITE_URL=http://localhost:3001

# ── Avisos: despacho da caixa de saída (notifications-dispatch) ─────────────
# Segredo que o pg_cron manda no cabeçalho `x-dispatch-secret`. O MESMO valor
# vai para o Vault do banco (ver docs/notificacoes.md). Vazio = despacho
# desligado: a função responde 503 `unconfigured` e os avisos ficam `pending`.
# Gere com: openssl rand -hex 32
NOTIFICATIONS_DISPATCH_SECRET=

# Push pelo Expo. Deixe vazio até o app ter projectId do EAS e pedir token;
# com o canal desligado os avisos de push ficam `unconfigured` (não se perdem).
# PUSH_PROVIDER=expo
PUSH_PROVIDER=
# Só se o projeto no Expo tiver "Enhanced push security" ligado.
EXPO_ACCESS_TOKEN=

# E-mail transacional: `resend` ou `postmark`. Vazio = canal desligado, avisos
# de e-mail ficam `unconfigured`. EMAIL_FROM precisa ser de domínio verificado
# no provedor, ex.: "Vez <avisos@seudominio.com.br>".
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# SMS e WhatsApp (canal do aviso na vez da fila) não têm provedor implementado:
# esses avisos ficam sempre `unconfigured`.

# ── Pagamentos (payment-*, billing-invoice-pay) ─────────────────────────────
# Decisão e passo a passo em docs/decisions/0009-pagamentos.md e
# docs/pagamentos.md. Sem estes secrets nada é cobrado: as funções respondem
# 503 `payment_unavailable` e o app do cliente continua dizendo "pagamento
# direto no estabelecimento".

# Qual adaptador cria as cobranças NOVAS. As antigas continuam sendo
# conciliadas pelo provedor que as criou. Hoje só existe `mercadopago`.
PAYMENT_PROVIDER=mercadopago

# Aplicação do Mercado Pago (painel de desenvolvedores → Suas integrações).
# ACCESS_TOKEN é o token da conta da Vez: recebe a mensalidade e a taxa do
# split. CLIENT_ID/CLIENT_SECRET são da aplicação e servem para o OAuth que
# liga a conta de cada loja. WEBHOOK_SECRET é a "assinatura secreta" da tela de
# Webhooks da aplicação.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=

# Assina o `state` do OAuth da loja. Gere com: openssl rand -hex 32
PAYMENTS_STATE_SECRET=

# Segredo que o pg_cron manda no cabeçalho `x-reconcile-secret`. O MESMO valor
# vai para o Vault do banco, junto com a URL da função (ver docs/pagamentos.md).
# Vazio = conciliação desligada. Gere com: openssl rand -hex 32
PAYMENTS_RECONCILE_SECRET=

# Para onde o dono volta depois de autorizar a conexão no provedor.
PORTAL_URL=http://localhost:3001

# Para onde o provedor devolve o cliente depois da página de cartão. O id da
# reserva é acrescentado no fim. Só mude se o esquema do app do cliente mudar.
CUSTOMER_APP_RETURN_URL=vezcliente://reserva/
