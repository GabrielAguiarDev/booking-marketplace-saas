{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.base.mjs"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_*",
        "NEXT_PUBLIC_PORTAL_URL",
        "NEXT_PUBLIC_COMPANY_*",
        "NEXT_PUBLIC_CONTACT_*",
        "NEXT_PUBLIC_PRIVACY_EMAIL",
        "NEXT_PUBLIC_CLIENT_*"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
