# Valores do stack Supabase local. Confirme com `pnpm db:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Portal do estabelecimento (login e cadastro da loja). Em produção, o domínio do portal.
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# Dados da empresa, contato e links do app do cliente. Todos opcionais: o que
# ficar vazio (ou inválido) some da página — nada de CNPJ ou e-mail de exemplo.
# O CNPJ só aparece se o dígito verificador conferir.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_CNPJ=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp da equipe, com DDD (ex.: 47999990000). Vira link wa.me.
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Canal do titular de dados (LGPD). Sem ele, a Privacidade usa o e-mail de contato.
NEXT_PUBLIC_PRIVACY_EMAIL=
# Links públicos do app do cliente nas lojas (https). Sem eles, /cliente diz que o app ainda não está publicado.
NEXT_PUBLIC_CLIENT_APP_STORE_URL=
NEXT_PUBLIC_CLIENT_PLAY_STORE_URL=
