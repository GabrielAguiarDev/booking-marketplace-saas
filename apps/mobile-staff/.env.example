# Valores do stack Supabase local. Confirme com `pnpm db:status`.
# Em dispositivo físico, troque 127.0.0.1 pelo IP da máquina na rede local.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Portal web da loja: cadastro, equipe, escala e correção do cadastro. O app
# abre este endereço no navegador. Em dispositivo físico, use o IP da máquina.
EXPO_PUBLIC_PORTAL_URL=http://localhost:3001

# Domínio do link universal do app da loja (ex.: loja.vez.app). Vazio = só o
# esquema vezstaff://. Ver app.config.ts antes de preencher.
EXPO_PUBLIC_STAFF_LINK_HOST=

# Projeto do EAS que assina o token de notificação (expo-notifications).
# Vazio = o app mostra "avisos ainda não disponíveis" e não grava aparelho.
EXPO_PUBLIC_EAS_PROJECT_ID=
