{
  "expo": {
    "name": "Vez Negócios",
    "slug": "vez-staff",
    "scheme": "vezstaff",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.vez.vez-staff"
    },
    "android": {
      "package": "app.vez.vezstaff"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Vez usa suas fotos para você escolher as imagens do perfil público da loja.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
